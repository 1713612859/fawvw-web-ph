{"seriesId":38,"name":"BESTUNE B70","describe":"Ultra-Safe Smart Luxury Sedan","images":{"main":"https://www-cdn.fawcar.com/global/prod-public-singapore/d6359cb4a1864bb78e1d263be2b3ed2c.jpeg","carousel":"https://www-cdn.fawcar.com/global/prod-public-singapore/06e27622dcc542adab36b965b61782a4.jpeg","small":"https://www-cdn.fawcar.com/global/prod-public-singapore/74336ea5ce3640cba4615c0ac7d08ed2.png","small2":"https://www-cdn.fawcar.com/global/prod-public-singapore/1a903b07dce745669529f96ce431298a.png","hero":"https://www-cdn.fawcar.com/global/prod-public-singapore/d6359cb4a1864bb78e1d263be2b3ed2c.jpeg","bigImgs":[]},"appearance":{"title":"Design That Stands Out","subtitle":"Signature brand styling, sleek and refined.","colors":[{"zh":"银","img":"https://www-cdn.fawcar.com/global/prod-public-singapore/a17e5f3eb1d4401b9d66cb4bf4b1f10d.png"},{"zh":"黑","img":"https://www-cdn.fawcar.com/global/prod-public-singapore/9f21a21466b147e79af97843ccbf7e19.png"},{"zh":"红","img":"https://www-cdn.fawcar.com/global/prod-public-singapore/ba21aa0bb94a4b82921745dca18be226.png"},{"zh":"灰","img":"https://www-cdn.fawcar.com/global/prod-public-singapore/beca80073fd447098a0a3facc3fe7b78.png"}]},"interior":{"title":"Space Beyond Its Class","subtitle":"A spacious cabin with versatile, practical room.","colors":[{"zh":"黑","img":"https://www-cdn.fawcar.com/global/prod-public-singapore/751790be79a34bdeac8348ca4b90dc29.png"}]},"sections":[{"type":"ImageTextSwitcher","title":"Modern Luxury, Bold Presence","items":[{"title":"The 4th-generation signature design language.","copy":"A seamless light strip integrates with the new digital logo. The frameless \"Mountain and Sea\" grille highlights its EV-ready character — clean, elegant, and commanding.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page4/1.jpg"},{"title":"Flowing Side Profile","copy":"Clean lines and smooth curves define the side, with every detail purposefully refined.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page4/2.jpg"},{"title":"Full-Width Taillight","copy":"The rear light strip echoes the front, embodying a sophisticated, minimalist beauty.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page4/3.jpg"}]},{"type":"CarouselPeek","title":"Spacious & Practical Comfort","items":[{"title":"A Cohesive, Premium Interior","copy":"An intuitive and comfortable layout features a curved 7\"+12.3\" display, multi-function steering wheel, paddle shifters, wireless charging, and smart storage — all in harmonious design.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page5/1.jpg"},{"title":"Power Liftback Tailgate","copy":"440L trunk (expandable to 930L) with a wide opening. Rear seats fold nearly flat for easy loading.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page5/2.jpg"},{"title":"Panoramic Sunroof","copy":"A larger glass area brings in more light, offers better views, and improves ventilation.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page5/3.jpg"}]},{"type":"ImageGallery","title":"Comprehensive Protection","items":[{"title":"540° Panoramic View","copy":"360° surround view plus a 180° under-vehicle view. Fast, clear 2D/3D imaging for safer maneuvering in tight spots and complex roads.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page6/1.jpg"},{"title":"L2+ Advanced Driving Assist","copy":"Includes ACC, SACC, Lane Departure Warning, Lane Keeping Assist, Forward Collision Warning with AEB, Blind Spot Assist, and Auto High Beam for all-around safety.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page6/2.jpg"},{"title":"New Dual-E Six-Channel Body Frame","copy":"A reinforced 3H structure with dual-E reinforcements and continuous longitudinal beams. Built with 76% high-strength steel and 22% hot-stamped steel (over 1500MPa yield strength) for superior crash protection from all angles.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page6/3.jpg"},{"title":"FMA Platform","copy":"Utilizes over 70% high-strength steel for safety, reliability, and flexibility. Meets CIRI MGGA standards.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page6/4.jpg"}]},{"type":"ThreeColumnCard","title":"Powerful & Confident Drive","items":[{"title":"2.0T Engine","copy":"165 kW, 340 N·m. 0-100 km/h in 7.86s. Combined fuel consumption: 7.24L/100km. Lightweight all-aluminum design for low vibration and quiet operation.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page7/1.jpg"},{"title":"Aisin 6-Speed Automatic","copy":"Features quick-shift technology, optimized gear ratios, and high efficiency. Includes idle start-stop, smooth and quiet operation with vibration damping, and proven reliability","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page7/2.jpg"},{"title":"Independent Suspension (Front & Rear)","copy":"MacPherson strut front, multi-link rear with stabilizer bar. Delivers precise handling, a comfortable ride, and confident, linear braking.","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page7/3.jpg"}]},{"type":"BigImage","title":"1","items":[{"title":"1","copy":"","img":"https://www.fawcar.com/file_cos/car-detail-picture-daniel/b70/Page8/8-2.jpg"}]}],"variants":["GCC-1.5T standard","GCC-1.5T luxury","GCC-1.5T premium","GCC-2.0T luxury"],"groups":[{"name":"Basic Specifications","rows":[["Level","Mid-size Car"],["Energy Type","Gasoline"],["Emission Standard","China VI"],["Max Power (kW)","124","124","124","165"],["Max Torque (N·m)","258","258","258","340"],["Transmission Type","7-Speed Wet DCT","7-Speed Wet DCT","7-Speed Wet DCT","6-Speed Automatic"],["Body Structure","5-Door 5-Seat Hatchback"],["Engine","1.5T","1.5T","1.5T","2.0T"],["L×W×H (mm)","4810*1840*1455"],["Max Speed","200","200","200","230"],["WLTC Combined Fuel Consumption (L/100km)","6.7","6.7","6.9","7.0"],["Curb Weight (kg)